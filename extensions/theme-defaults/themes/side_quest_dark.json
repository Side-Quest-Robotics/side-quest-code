	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#636B75",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords & Storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"name": "Storage modifiers (plain text)",
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#D4D6D8"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#B5CEA8"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language"
			],
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#DCDCAA"
			}
		},
		{
			"name": "Types, classes, interfaces",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "HTML/JSX tags",
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Entity names & definitions",
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#E8B968"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.other"
			],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Parameters & block context",
			"scope": [
				"variable.parameter.function",
				"meta.jsx.children",
				"meta.block",
				"meta.tag.attributes",
				"meta.object.member",
				"meta.embedded.expression"
			],
			"settings": {
				"foreground": "#D4D6D8"
			}
		},
		{
			"name": "JSON properties",
			"scope": [
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#7ECE8C"
			}
		},
		{
			"name": "CSS property names",
			"scope": "meta.property-name",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "String variable interpolation",
			"scope": "string variable",
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Regex",
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"name": "Regex escape",
			"scope": "string.regexp constant.character.escape",
			"settings": {
				"foreground": "#7ECE8C",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Embedded punctuation",
			"scope": "punctuation.section.embedded",
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"name": "Markup headings",
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#4EC9B0",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup italic",
			"scope": "markup.italic",
			"settings": {
				"foreground": "#D4D6D8",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup bold",
			"scope": "markup.bold",
			"settings": {
				"foreground": "#D4D6D8",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup links",
			"scope": [
				"constant.other.reference.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#5CC5B0"
			}
		},
		{
			"name": "Diff inserted",
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#7ECE8C"
			}
		},
		{
			"name": "Diff deleted",
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#F07178"
			}
		},
		{
			"name": "Diff changed",
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#E8B968"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"type": "#4EC9B0",
		"class": "#4EC9B0",
		"interface": "#4EC9B0",
		"enum": "#4EC9B0",
		"typeParameter": "#4EC9B0",
		"namespace": "#4EC9B0",
		"function": "#DCDCAA",
		"method": "#DCDCAA",
		"macro": "#DCDCAA",
		"variable": "#9CDCFE",
		"parameter": "#9CDCFE",
		"property": "#9CDCFE",
		"enumMember": "#4FC1FF",
		"string": "#CE9178",
		"number": "#B5CEA8",
		"keyword": "#C586C0",
		"comment": {
			"foreground": "#636B75",
			"fontStyle": "italic"
		}
	}
}